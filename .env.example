# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/auth_db_test

# Redis
REDIS_URL=redis://localhost:6379/0

# App
DEBUG_MODE=True
APP_BASE_URL=http://localhost:8000

# JWT signing keys — path to the directory containing private_key.pem and public_key.pem
KEYS_DIRECTORY=./keys

# Resend (email sending)
RESEND_API_KEY=your-resend-api-key
RESEND_EMAIL_ADDRESS=noreply@yourdomain.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback